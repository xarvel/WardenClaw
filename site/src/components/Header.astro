---
import type { Dict } from "../i18n/en";
import { REPO_PUBLIC, REPO_URL } from "../config";

interface Props {
  t: Dict;
  /** "" on the landing page (same-page anchors); the landing path elsewhere. */
  home?: string;
  current?: "docs" | "install";
}
const { t, home = "", current } = Astro.props;
const docsPath = `${t.path}docs/`;
const installPath = `${t.path}docs/install/`;
const sections = [
  ["problem", t.nav.problem],
  ["how", t.nav.how],
  ["modes", t.nav.modes],
  ["security", t.nav.security],
  ["compare", t.nav.compare],
  ["faq", t.nav.faq],
];
const gh = `<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>`;
const burger = `<svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 5h14M3 10h14M3 15h14"/></svg>`;
---
<a class="skip" href="#main">{t.skip}</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={t.path} aria-label="WardenClaw">
      <img src="/brand/logo.svg" alt="" width="28" height="28" />
      <span>WardenClaw</span>
    </a>
    {/* Landing sections inline on wide screens; below the breakpoint they move into the menu. */}
    <nav class="site-nav" aria-label={t.nav.sections}>
      {sections.map(([id, label]) => <a href={`${home}#${id}`}>{label}</a>)}
    </nav>
    {/* Docs and Install stay in the header at every width. */}
    <nav class="site-nav-main" aria-label="Primary">
      <a href={docsPath} aria-current={current === "docs" ? "page" : undefined}>{t.nav.docs}</a>
      <a href={installPath} aria-current={current === "install" ? "page" : undefined}>{t.nav.install}</a>
    </nav>
    <div class="header-actions">
      {REPO_PUBLIC ? (
        <a class="pill pill-gh" href={REPO_URL}><Fragment set:html={gh} /><span class="sr-only">{t.nav.github}</span></a>
      ) : (
        <span class="pill pill-gh pill-off" title={t.repoClosed}><Fragment set:html={gh} /><span class="sr-only">{t.nav.github}: {t.repoClosed}</span></span>
      )}
    </div>
    {/* No JS: a <details> menu for narrow screens and zoomed-in laptops (global.css). */}
    <details class="menu">
      <summary><Fragment set:html={burger} /><span class="menu-label">{t.nav.menu}</span></summary>
      <nav class="menu-panel" aria-label={t.nav.menu}>
        <ul>
          {sections.map(([id, label]) => <li><a href={`${home}#${id}`}>{label}</a></li>)}
        </ul>
        <ul>
          <li><a href={docsPath}>{t.nav.docs}</a></li>
          <li><a href={installPath}>{t.nav.install}</a></li>
          <li><a href={`${t.path}security/`}>{t.footer.report}</a></li>
        </ul>
        <ul>
          <li>{REPO_PUBLIC ? <a href={REPO_URL}>GitHub</a> : <span>{t.repoClosed}</span>}</li>
        </ul>
      </nav>
    </details>
  </div>
</header>
