# Local values for WardenClaw development. Copy to .env.local (it is in .gitignore) and fill in.
# No .env* file is uploaded to EAS (.easignore at the monorepo root) or ends up in a release
# build: build values come only from the profile env in eas.json (production and preview set
# EXPO_PUBLIC_WARDENCLAW_* explicitly to "unset", the eas.json schema rejects empty values), and
# scripts/check-build-env.mjs refuses to build production or preview with personal values.
# Empty value = empty default from the code.

# Hints for debugging with Metro only (npx expo start, __DEV__). A release build has none of them
# even with non-empty values: the code reads them only under __DEV__, and the judge makes no
# network calls without an address and model name saved in the app.
# OpenClaw gateway for the optional adapter (wss://<your-gateway>).
EXPO_PUBLIC_WARDENCLAW_GATEWAY_URL=
# OpenAI-compatible judge endpoint (…/v1) and the model name on it.
EXPO_PUBLIC_WARDENCLAW_MODEL_URL=
EXPO_PUBLIC_WARDENCLAW_MODEL=

# Paths where trash-put is forbidden are now a setting in the app ("Mode" → "Local rules").

# Only for scripts/*.sh (not included in the bundle):
# where to put downloaded APKs (default ./build/apk)
WARDENCLAW_APK_DIR=
# file with the Expo token (default ~/.config/wardenclaw/expo_token)
WARDENCLAW_EXPO_TOKEN_FILE=
